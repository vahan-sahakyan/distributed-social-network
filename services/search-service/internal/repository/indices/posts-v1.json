{
  "aliases": {
    "posts": { "is_write_index": true }
  },
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "author_id": { "type": "keyword" },
      "text": {
        "type": "text",
        "analyzer": "english",
        "fields": {
          "exact": { "type": "text", "analyzer": "standard" }
        }
      },
      "image_id": { "type": "keyword", "index": false },
      "hashtags": { "type": "keyword" },
      "created_at": { "type": "date" }
    }
  }
}
