# generated by scripts/gen-dockerfiles.sh
FROM golang:1.27-alpine3.24 AS builder
WORKDIR /app
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/media-service/go.mod services/media-service/go.sum ./services/media-service/
WORKDIR /app/services/media-service
RUN --mount=type=cache,target=/go/pkg/mod go mod download
WORKDIR /app
COPY pkg/grpc/media/ ./pkg/grpc/media/
COPY pkg/id/ ./pkg/id/
COPY pkg/observability/ ./pkg/observability/
COPY pkg/retry/ ./pkg/retry/
COPY services/media-service/ ./services/media-service/
WORKDIR /app/services/media-service
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /bin/service ./cmd

FROM alpine:3.24
RUN apk --no-cache add ca-certificates
COPY --from=builder /bin/service /service
USER 65532:65532
ENTRYPOINT ["/service"]
