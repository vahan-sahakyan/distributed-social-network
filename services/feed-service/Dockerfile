FROM golang:1.27-alpine3.24 AS builder
WORKDIR /app
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/feed-service/go.mod services/feed-service/go.sum ./services/feed-service/
WORKDIR /app/services/feed-service
RUN --mount=type=cache,target=/go/pkg/mod go mod download
WORKDIR /app
COPY pkg/broker/ ./pkg/broker/
COPY pkg/cache/ ./pkg/cache/
COPY pkg/events/ ./pkg/events/
COPY pkg/grpc/feed/ ./pkg/grpc/feed/
COPY pkg/grpc/posts/ ./pkg/grpc/posts/
COPY pkg/grpc/users/ ./pkg/grpc/users/
COPY pkg/observability/ ./pkg/observability/
COPY services/feed-service/ ./services/feed-service/
WORKDIR /app/services/feed-service
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /bin/service ./cmd

FROM alpine:3.24
RUN apk --no-cache add ca-certificates
COPY --from=builder /bin/service /service
ENTRYPOINT ["/service"]
