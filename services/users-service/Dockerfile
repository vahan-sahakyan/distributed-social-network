FROM golang:1.27-alpine3.24 AS builder
WORKDIR /app
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/users-service/go.mod services/users-service/go.sum ./services/users-service/
WORKDIR /app/services/users-service
RUN --mount=type=cache,target=/go/pkg/mod go mod download
WORKDIR /app
COPY pkg/broker/ ./pkg/broker/
COPY pkg/database/ ./pkg/database/
COPY pkg/events/ ./pkg/events/
COPY pkg/grpc/users/ ./pkg/grpc/users/
COPY pkg/observability/ ./pkg/observability/
COPY pkg/outbox/ ./pkg/outbox/
COPY pkg/retry/ ./pkg/retry/
COPY pkg/validate/ ./pkg/validate/
COPY services/users-service/ ./services/users-service/
WORKDIR /app/services/users-service
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /bin/service ./cmd

FROM alpine:3.24
RUN apk --no-cache add ca-certificates
COPY --from=builder /bin/service /service
ENTRYPOINT ["/service"]
